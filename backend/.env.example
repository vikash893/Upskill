# Server
PORT=8000
WEB_CONCURRENCY=1
TRUST_PROXY=false
NODE_ENV=development

# MongoDB
MONGO_URL=mongodb://127.0.0.1:27017/uniskill_local_database
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=2

# Redis
REDIS_URL=redis://127.0.0.1:6379
REDIS_REQUIRED=false

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_SSL=false
KAFKA_CLIENT_ID=uniskill-backend

# Auth / Security
JWT_SECRET=replace_with_a_long_random_secret
# Used to generate secure platform live-class URLs such as /live-class/:classId.
FRONTEND_URL=http://localhost:5173

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payments
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Use a separate secret configured for the /api/payment/webhook endpoint in Razorpay.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Recording / Live-class runtime
RECORDING_CHUNK_SECONDS=60
RECORDING_STORAGE_PATH=./uploads/recordings
MEDIA_SERVER_TYPE=mediasoup
SFU_LISTEN_IP=0.0.0.0
SFU_ANNOUNCED_IP=127.0.0.1
SFU_MIN_PORT=10000
SFU_MAX_PORT=10100

# Google Meet / Calendar
GOOGLE_MEET_ENABLED=false
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Must exactly match the OAuth client redirect URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/meet/callback
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=UTC
# Use all so invited students receive restricted Meet calendar updates.
GOOGLE_CALENDAR_SEND_UPDATES=all
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=

# Teacher-specific Meet OAuth requires the OAuth client ID, secret, callback URI above,
# and the meetings.space.settings scope. Existing teachers should reconnect Google Meet
# after this setting is deployed so restricted Meet spaces can be created.
# Service-account credentials are optional server-side API credentials and do not verify a teacher account.
